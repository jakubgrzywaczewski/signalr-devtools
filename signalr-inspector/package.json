{
  "name": "signalr-inspector",
  "version": "1.2.23",
  "private": true,
  "description": "Inspect ASP.NET Core SignalR messages, invocation flows, and connection timelines in DevTools.",
  "scripts": {
    "check": "biome check . --diagnostic-level=warn --error-on-warnings --max-diagnostics=none",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --diagnostic-level=warn --error-on-warnings --max-diagnostics=none",
    "lint:fix": "biome lint --write .",
    "precommit:check": "node scripts/pre-commit.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.mjs",
    "test:e2e:install": "playwright install chromium",
    "analysis:check": "node scripts/check-analysis-package.mjs",
    "analysis:pack": "node scripts/analysis-package.mjs npm pack",
    "analysis:publish": "node scripts/analysis-package.mjs npm publish",
    "analysis:version:bump": "node scripts/analysis-package.mjs version:bump",
    "demo:generate": "node scripts/generate-demo.mjs",
    "version:bump": "node scripts/version-policy.mjs --bump",
    "version:check": "node scripts/version-policy.mjs --check",
    "package": "mkdir -p ../dist && zip -FSr ../dist/signalr-inspector.zip manifest.json activation.js background.js contentScript.js injected.js devtools.html devtools.js longPolling.js msgpackDecoder.js panel.html panel.css panel.js sessionFormat.js signalrAnalysis.js signalrProtocol.js icons AUTHORS.md LICENSE.md PRIVACY.md"
  },
  "keywords": [
    "chrome-extension",
    "signalr",
    "devtools",
    "websocket",
    "aspnetcore"
  ],
  "author": "Jakub Grzywaczewski",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.65.0",
    "@vitest/coverage-v8": "5.1.0",
    "acorn": "8.19.0",
    "eslint-scope": "9.1.2",
    "gifenc": "^1.0.3",
    "jsdom": "^31.0.0",
    "playwright": "1.65.0",
    "pngjs": "^7.0.0",
    "simple-git-hooks": "2.14.0",
    "vitest": "5.1.0"
  }
}
