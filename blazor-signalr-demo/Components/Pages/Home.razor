@page "/"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>SignalR Chat</PageTitle>

<div class="chat-container">
    <header>
        <h1>SignalR Chat (endpoint <code>/grpc/chat</code>)</h1>
        <p class="status">@statusMessage</p>
    </header>

    <section class="composer" aria-live="polite">
        <label>
            Nick
            <input @bind="userName" @bind:event="oninput" />
        </label>
        <label class="message-field">
            Wiadomość
            <textarea rows="3" @bind="message" @bind:event="oninput"></textarea>
        </label>
        <button @onclick="SendMessageAsync" disabled="@(!isConnected || isSending || string.IsNullOrWhiteSpace(message))">
            @((isSending ? "Wysyłanie..." : "Wyślij"))
        </button>
    </section>

    <section class="history" aria-live="polite">
        <h2>Ostatnie wiadomości</h2>
        @if (messages.Count == 0)
        {
            <p class="empty">Brak wiadomości.</p>
        }
        else
        {
            <ul>
                @foreach (var entry in messages)
                {
                    <li>
                        <span class="timestamp">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                        <strong>@entry.User:</strong>
                        <span>@entry.Text</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private readonly List<ChatMessage> messages = new();
    private DotNetObjectReference<Home>? dotNetRef;
    private string userName = "Tester";
    private string message = string.Empty;
    private bool isConnected;
    private bool isSending;
    private string statusMessage = "Nawiązywanie połączenia...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await EnsureConnectionAsync();
        }
    }

    private async Task EnsureConnectionAsync()
    {
        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            await JS.InvokeVoidAsync("chatClient.init", baseUrl, dotNetRef);
            isConnected = true;
            statusMessage = "Połączono z /grpc/chat";
        }
        catch (Exception ex)
        {
            statusMessage = $"Błąd połączenia: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendMessageAsync()
    {
        if (!isConnected || string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        isSending = true;
        var payload = message.Trim();
        var displayName = string.IsNullOrWhiteSpace(userName) ? "Anon" : userName.Trim();
        try
        {
            await JS.InvokeVoidAsync("chatClient.send", displayName, payload);
            message = string.Empty;
        }
        catch (Exception ex)
        {
            statusMessage = $"Nie udało się wysłać: {ex.Message}";
        }
        finally
        {
            isSending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnMessageReceived(string user, string text, string timestamp)
    {
        var parsed = DateTimeOffset.TryParse(timestamp, out var value)
            ? value
            : DateTimeOffset.UtcNow;

        messages.Insert(0, new ChatMessage(user, text, parsed));
        if (messages.Count > 50)
        {
            messages.RemoveAt(messages.Count - 1);
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("chatClient.stop");
            }
            catch
            {
                // Ignorujemy błędy przy wygaszaniu połączenia
            }

            dotNetRef.Dispose();
        }
    }

    private record ChatMessage(string User, string Text, DateTimeOffset Timestamp);
}
