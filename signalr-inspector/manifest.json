{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "SignalR Inspector",
  "version": "0.5.0",
  "description": "A Chrome DevTools panel for inspecting ASP.NET Core SignalR traffic.",
  "author": "Jakub Grzywaczewski",
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Enable SignalR Inspector for this tab",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  }
}
