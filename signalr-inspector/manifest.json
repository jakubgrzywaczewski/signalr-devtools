{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "SignalR Inspector",
  "version": "0.10.0",
  "description": "Inspect ASP.NET Core SignalR messages, invocation flows, and connection timelines in DevTools.",
  "author": "Jakub Grzywaczewski",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Enable SignalR Inspector for this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  }
}
