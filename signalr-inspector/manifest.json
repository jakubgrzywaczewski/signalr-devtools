{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "SignalR Inspector",
  "version": "0.3.0",
  "description": "A Chrome DevTools panel for inspecting ASP.NET Core SignalR traffic.",
  "author": "Jakub Grzywaczewski",
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["<all_urls>"],
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
